generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String
  phone      String   @unique
  address    String
  points     Decimal? @default(0)
  created_at DateTime @default(now())
  cart       Cart[]
  orders     Order[]
}

model Admin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String   @unique
  createdAt DateTime @default(now())
}

model Pizza {
  id                 String               @id @default(cuid())
  name               String
  description        String?
  imageUrl           String?
  categoryId         String
  createdAt          DateTime             @default(now())
  sizes              Json
  cartItems          CartItem[]
  comboItems         ComboItem[]
  comboPizzas        ComboPizza[]
  defaultIngredients DefaultIngredients[]
  defaultToppings    DefaultToppings[]
  orderItems         OrderItem[]
  category           Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model ComboOffers {
  id          String       @id @default(cuid())
  name        String
  description String
  imageUrl    String
  discount    Decimal
  createdAt   DateTime     @default(now())
  price       Decimal
  cartItems   CartItem[]
  comboItems  ComboItem[]
  pizzas      ComboPizza[]
  orderItems  OrderItem[]
}

model ComboPizza {
  id       String      @id @default(cuid())
  comboId  String
  pizzaId  String
  quantity Int
  size     String
  combo    ComboOffers @relation(fields: [comboId], references: [id], onDelete: Cascade)
  pizza    Pizza       @relation(fields: [pizzaId], references: [id], onDelete: Cascade)
}

model Cart {
  id          String     @id @default(cuid())
  userId      String?
  totalAmount Decimal    @default(0)
  createdAt   DateTime   @default(now())
  sessionId   String?    @unique
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
}

model CartItem {
  id                   String            @id @default(cuid())
  cartId               String
  pizzaId              String?
  size                 String
  quantity             Int
  basePrice            Decimal
  finalPrice           Decimal
  createdAt            DateTime          @default(now())
  isCombo              Boolean           @default(false)
  comboId              String?
  isOtherItem          Boolean           @default(false)
  otherItemId          String?
  pizzaBase            String?
  sauce                String?
  isMealDeal           Boolean           @default(false)
  isPeriPeri           Boolean           @default(false)
  periPeriId           String?
  comboStyleItemId     String?
  selectedDrinks       String?
  selectedSides        String?
  userChoiceId         String?
  userChoiceSelections String?
  additionalToppingCost Decimal?          @default(0)
  maxToppings          Int?              @default(4)
  pizzaBuilderDealId   String?
  selectedPizzaId      String?
  selectedSize         String?
  selectedToppings     Json?
  cartIngredients      CartIngredients[]
  cart                 Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  combo                ComboOffers?      @relation(fields: [comboId], references: [id], onDelete: Cascade)
  comboStyleItem       ComboStyleItem?   @relation(fields: [comboStyleItemId], references: [id], onDelete: Cascade)
  otherItem            OtherItem?        @relation(fields: [otherItemId], references: [id], onDelete: Cascade)
  periPeri             PeriPeriItem?     @relation(fields: [periPeriId], references: [id], onDelete: Cascade)
  pizzaBuilderDeal     PizzaBuilderDeal? @relation("CartPizzaBuilder", fields: [pizzaBuilderDealId], references: [id], onDelete: Cascade)
  pizza                Pizza?            @relation(fields: [pizzaId], references: [id], onDelete: Cascade)
  userChoice           UserChoice?       @relation(fields: [userChoiceId], references: [id], onDelete: Cascade)
  cartToppings         CartToppings[]
}

model CartToppings {
  id              String       @id @default(cuid())
  cartItemId      String
  toppingId       String
  defaultQuantity Int
  addedQuantity   Int
  cartItem        CartItem     @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  topping         ToppingsList @relation(fields: [toppingId], references: [id], onDelete: Cascade)
}

model CartIngredients {
  id              String          @id @default(cuid())
  cartItemId      String
  ingredientId    String
  defaultQuantity Int
  addedQuantity   Int
  cartItem        CartItem        @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  ingredient      IngredientsList @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal
  createdAt       DateTime    @default(now())
  customerName    String
  deliveryAddress String?
  deliveryMethod  String
  paymentId       String?
  paymentStatus   String
  pickupTime      String?
  orderTiming     String      @default("asap")
  preorderDate    String?
  preorderTime    String?
  customerNotes   String?
  user            User        @relation(fields: [userId], references: [id])
  orderItems      OrderItem[]
}

model OrderItem {
  id                   String             @id @default(cuid())
  orderId              String
  quantity             Int
  size                 String
  price                Decimal
  pizzaId              String?
  comboId              String?
  isCombo              Boolean            @default(false)
  otherItemId          String?
  createdAt            DateTime           @default(now())
  isOtherItem          Boolean            @default(false)
  pizzaBase            String?
  sauce                String?
  isMealDeal           Boolean            @default(false)
  isPeriPeri           Boolean            @default(false)
  periPeriId           String?
  comboStyleItemId     String?
  selectedDrinks       String?
  selectedSides        String?
  userChoiceId         String?
  userChoiceSelections String?
  pizzaBuilderData     String?
  pizzaBuilderDealId   String?
  orderIngredients     OrderIngredients[]
  combo                ComboOffers?       @relation(fields: [comboId], references: [id])
  comboStyleItem       ComboStyleItem?    @relation(fields: [comboStyleItemId], references: [id])
  order                Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  otherItem            OtherItem?         @relation(fields: [otherItemId], references: [id])
  periPeri             PeriPeriItem?      @relation(fields: [periPeriId], references: [id])
  pizzaBuilderDeal     PizzaBuilderDeal?  @relation("OrderPizzaBuilder", fields: [pizzaBuilderDealId], references: [id])
  pizza                Pizza?             @relation(fields: [pizzaId], references: [id])
  userChoice           UserChoice?        @relation(fields: [userChoiceId], references: [id])
  orderToppings        OrderToppings[]
}

model OrderToppings {
  id          String    @id @default(cuid())
  name        String
  price       Decimal
  status      Boolean
  include     Boolean
  quantity    Int
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model OrderIngredients {
  id          String    @id @default(cuid())
  name        String
  price       Decimal
  status      Boolean
  include     Boolean
  quantity    Int
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model DefaultToppings {
  id        String       @id @default(cuid())
  name      String
  price     Decimal
  quantity  Int
  include   Boolean
  pizzaId   String
  toppingId String
  pizza     Pizza        @relation(fields: [pizzaId], references: [id], onDelete: Cascade)
  topping   ToppingsList @relation(fields: [toppingId], references: [id], onDelete: Cascade)
}

model DefaultIngredients {
  id           String          @id @default(cuid())
  name         String
  price        Decimal
  quantity     Int
  include      Boolean
  pizzaId      String
  ingredientId String
  ingredient   IngredientsList @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  pizza        Pizza           @relation(fields: [pizzaId], references: [id], onDelete: Cascade)
}

model ToppingsList {
  id              String            @id @default(cuid())
  name            String
  price           Decimal
  status          Boolean           @default(true)
  cartToppings    CartToppings[]
  defaultToppings DefaultToppings[]
}

model IngredientsList {
  id                 String               @id @default(cuid())
  name               String
  price              Decimal
  status             Boolean              @default(true)
  cartIngredients    CartIngredients[]
  defaultIngredients DefaultIngredients[]
}

model Category {
  id                String             @id @default(cuid())
  name              String
  description       String?
  comboStyleItems   ComboStyleItem[]
  otherItems        OtherItem[]
  pizzas            Pizza[]
  userChoices       UserChoice[]       @relation("UserChoiceDisplayCategory")
  pizzaBuilderDeals PizzaBuilderDeal[] @relation("PizzaBuilderDisplayCategory")
}

model OtherItem {
  id              String      @id @default(cuid())
  name            String
  description     String?
  imageUrl        String?
  price           Decimal
  createdAt       DateTime    @default(now())
  categoryId      String
  availableSauces String?
  cartItems       CartItem[]
  comboItems      ComboItem[]
  orderItems      OrderItem[]
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model PeriPeriItem {
  id              String      @id @default(cuid())
  name            String
  description     String?
  imageUrl        String?
  basePrice       Decimal
  mealDealPrice   Decimal?
  sideCount       Int         @default(0)
  drinkCount      Int         @default(0)
  itemType        String
  availableSauces String
  createdAt       DateTime    @default(now())
  cartItems       CartItem[]
  orderItems      OrderItem[]
}

model ComboStyleItem {
  id              String      @id @default(cuid())
  name            String
  description     String?
  imageUrl        String?
  categoryId      String
  sizePricing     Json
  availableSauces Json
  mealDealConfig  Json
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  cartItems       CartItem[]
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
}

model ComboItem {
  id          String      @id @default(cuid())
  comboId     String
  pizzaId     String?
  otherItemId String?
  quantity    Int
  size        String?
  itemType    String      @default("PIZZA")
  combo       ComboOffers @relation(fields: [comboId], references: [id], onDelete: Cascade)
  otherItem   OtherItem?  @relation(fields: [otherItemId], references: [id], onDelete: Cascade)
  pizza       Pizza?      @relation(fields: [pizzaId], references: [id], onDelete: Cascade)

  @@unique([comboId, pizzaId, otherItemId, size])
}

model UserChoice {
  id                String      @id @default(cuid())
  name              String
  description       String?
  imageUrl          String?
  displayCategoryId String
  basePrice         Decimal
  categoryConfigs   Json
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  cartItems         CartItem[]
  orderItems        OrderItem[]
  displayCategory   Category    @relation("UserChoiceDisplayCategory", fields: [displayCategoryId], references: [id], onDelete: Cascade)
}

model DeliveryZone {
  id          String   @id @default(cuid())
  name        String
  minDistance Decimal
  maxDistance Decimal
  charge      Decimal
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("delivery_zones")
}

model DeliverySettings {
  id                  String   @id @default(cuid())
  maxDeliveryDistance Decimal  @default(4)
  isDeliveryEnabled   Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  shopAddress         String?
  shopLatitude        Decimal?
  shopLongitude       Decimal?
  shopName            String?
  shopPhone           String?

  @@map("delivery_settings")
}

model PizzaBuilderDeal {
  id                String      @id @default(cuid())
  name              String
  description       String?
  imageUrl          String?
  maxToppings       Int         @default(4)
  displayCategoryId String
  availableSizes    Json
  availableToppings Json
  sizePricing       Json
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  availableBases    Json
  availableSauces   Json
  cartItems         CartItem[]  @relation("CartPizzaBuilder")
  orderItems        OrderItem[] @relation("OrderPizzaBuilder")
  displayCategory   Category    @relation("PizzaBuilderDisplayCategory", fields: [displayCategoryId], references: [id], onDelete: Cascade)

  @@map("pizza_builder_deals")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum PizzaSize {
  MEDIUM
  LARGE
  SUPER_SIZE
}
